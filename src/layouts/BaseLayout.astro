---
import "lenis/dist/lenis.css";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/utilities.css";
import "../styles/site.css";
import ChatWidget from "../components/layout/ChatWidget.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import SiteScripts from "../components/layout/SiteScripts.astro";
import StructuredData from "../components/seo/StructuredData.astro";
import { withBase } from "../utils/paths";

interface Props {
  title: string;
  description: string;
  currentPage?: "home" | "aircraft" | "contact" | "terms";
  showCredits?: boolean;
  noIndex?: boolean;
  preloadImage?: string;
}

const {
  title,
  description,
  currentPage,
  showCredits = false,
  noIndex = false,
  preloadImage,
} = Astro.props;
const site = Astro.site ?? Astro.url;
const canonicalPath = currentPage === "home"
  ? withBase()
  : Astro.url.pathname.replace(/\/$/, "");
const pageUrl = new URL(canonicalPath, site);
const ogImageUrl = new URL(withBase("og-image.jpg"), site);
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noIndex
        ? "noindex, follow"
        : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    {googleVerification && (
      <meta name="google-site-verification" content={googleVerification} />
    )}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bespoke Aviation" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Bespoke Aviation — Private Aviation. Personally Managed."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta
      name="twitter:image:alt"
      content="Bespoke Aviation — Private Aviation. Personally Managed."
    />
    <meta name="theme-color" content="#121b2a" />
    <link rel="manifest" href={withBase("manifest.webmanifest")} />
    <link
      rel="icon"
      type="image/svg+xml"
      href={withBase("Favicons/Favicon.svg")}
    />
    <link rel="icon" href={withBase("favicon.ico")} sizes="any" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={withBase("Favicons/favicon-32x32.png")}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href={withBase("Favicons/favicon-16x16.png")}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={withBase("Favicons/apple-touch-icon.png")}
    />
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} type="image/avif" fetchpriority="high" />
    )}
    <link
      rel="preload"
      href={withBase("fonts/dm-sans-latin.woff2")}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={withBase("fonts/manrope-latin.woff2")}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    {!noIndex && (
      <StructuredData
        title={title}
        description={description}
        currentPage={currentPage}
        pageUrl={pageUrl}
      />
    )}
  </head>
  <body>
    <SiteHeader currentPage={currentPage} />
    <slot />
    <SiteFooter showCredits={showCredits} />
    <ChatWidget />
    <SiteScripts />
  </body>
</html>
