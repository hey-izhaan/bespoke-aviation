---
import "swiper/css";
import "swiper/css/effect-fade";
import { testimonials } from "../../data/testimonials";
---

<section class="testimonial" id="testimonials">
  <div class="testimonial-photo">
    <img
      src="https://images.unsplash.com/photo-1436491865332-7a61a109cc05?auto=format&fit=crop&w=1600&q=86"
      alt="View from a private aircraft window above the clouds"
      loading="lazy"
    />
  </div>
  <div class="testimonial-copy">
    <p class="eyebrow">Client experience</p>
    <img class="stars" src="/Stars.png" alt="5 out of 5 stars" />
    <div class="swiper testimonial-swiper">
      <div class="swiper-wrapper">
        {testimonials.map(({ quote, client }) => (
          <div class="swiper-slide">
            <blockquote>“{quote}”</blockquote>
            <p class="client-name">{client}</p>
          </div>
        ))}
      </div>
    </div>
    <div class="testimonial-nav">
      <button class="testimonial-prev" type="button" aria-label="Previous testimonial">
        <span class="airplane-icon plane-left" aria-hidden="true"></span>
      </button>
      <span class="testimonial-count" aria-live="polite">01 / {String(testimonials.length).padStart(2, "0")}</span>
      <button class="testimonial-next" type="button" aria-label="Next testimonial">
        <span class="airplane-icon plane-right" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</section>

<script>
  import Swiper from "swiper";
  import { EffectFade, Keyboard, Navigation } from "swiper/modules";

  const slider = document.querySelector<HTMLElement>(".testimonial-swiper");
  if (slider) {
    const copy = slider.closest<HTMLElement>(".testimonial-copy");
    const count = copy?.querySelector<HTMLElement>(".testimonial-count");
    const total = slider.querySelectorAll(".swiper-slide").length;

    new Swiper(slider, {
      modules: [EffectFade, Keyboard, Navigation],
      slidesPerView: 1,
      speed: matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 550,
      effect: "fade",
      fadeEffect: { crossFade: true },
      autoHeight: true,
      loop: true,
      grabCursor: true,
      keyboard: { enabled: true, onlyInViewport: true },
      navigation: {
        prevEl: copy?.querySelector<HTMLElement>(".testimonial-prev"),
        nextEl: copy?.querySelector<HTMLElement>(".testimonial-next"),
      },
      on: {
        init(swiper) {
          if (count) {
            count.textContent = `${String(swiper.realIndex + 1).padStart(2, "0")} / ${String(total).padStart(2, "0")}`;
          }
        },
        slideChange(swiper) {
          if (count) {
            count.textContent = `${String(swiper.realIndex + 1).padStart(2, "0")} / ${String(total).padStart(2, "0")}`;
          }
        },
      },
    });
  }
</script>
