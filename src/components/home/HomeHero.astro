---
import { withBase } from "../../utils/paths";
import Button from "../ui/Button.astro";

interface Props {
  posterSrc: string;
}

const { posterSrc } = Astro.props;
const videoPriority = { fetchpriority: "high" } as const;
---

<section class="hero">
  <video
    class="hero-video"
    autoplay
    muted
    loop
    playsinline
    poster={posterSrc}
    {...videoPriority}
  >
    <source src={withBase("Hero%20Video.mp4")} type="video/mp4" />
  </video>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <p class="eyebrow light">Independent private aircraft charter</p>
    <h1>Private Aviation.<br /><em>Personally Managed.</em></h1>
    <p class="hero-intro">
      Direct, independent aircraft charter advice from first enquiry to safe arrival —
      personally managed by Mark Rowlands.
    </p>
    <div class="hero-actions">
      <Button href="#enquiry" variant="light">Plan your journey</Button>
      <Button href="#mark" variant="text" class="light">Meet Mark</Button>
    </div>
  </div>
</section>
