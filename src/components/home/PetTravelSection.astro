---
import { Picture } from "astro:assets";
import petCabinPhoto from "../../assets/images/pet-travel-cabin.png";
import { withBase } from "../../utils/paths";
import SectionLabel from "../ui/SectionLabel.astro";
---

<section class="pet-travel section-pad" id="pet-travel">
  <div class="pet-travel-inner">
    <div class="pet-travel-photo">
      <Picture
        src={petCabinPhoto}
        formats={["avif"]}
        fallbackFormat="avif"
        widths={[720, 1200]}
        sizes="(max-width: 900px) 100vw, 58vw"
        quality={76}
        alt="A dog resting comfortably inside a private jet cabin"
        loading="lazy"
      />
      <div class="pet-travel-photo-note">
        <span>Pet-friendly charter</span>
        <small>Planned around their comfort</small>
      </div>
    </div>

    <div class="pet-travel-copy">
      <SectionLabel number="03">Pet travel</SectionLabel>
      <h2>Every passenger<br /><em>matters.</em></h2>
      <p class="lead">
        Your journey can include every member of the family. We coordinate the details so
        your companion can travel safely and comfortably by your side.
      </p>

      <div class="pet-travel-points">
        <article>
          <span>01</span>
          <div>
            <h3>Tell us in advance</h3>
            <p>Share your pet's breed, size and travel needs when you enquire.</p>
          </div>
        </article>
        <article>
          <span>02</span>
          <div>
            <h3>Prepare their documents</h3>
            <p>We will outline the passports, health records and permits needed for your route.</p>
          </div>
        </article>
        <article>
          <span>03</span>
          <div>
            <h3>We coordinate the details</h3>
            <p>Travel remains subject to operator approval, aircraft suitability and local rules.</p>
          </div>
        </article>
      </div>

      <a class="text-link" href={withBase("terms") + "#pet-travel"}>
        Read pet travel terms
        <span class="airplane-icon plane-up-right" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</section>
