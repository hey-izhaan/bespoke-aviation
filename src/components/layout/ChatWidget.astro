---
import { Image } from "astro:assets";
import markPortrait from "../../assets/images/mark-rowlands.avif";
---

<aside class="chat-widget" aria-label="Contact Bespoke Aviation">
  <div class="chat-teaser">
    <button
      class="chat-teaser-open"
      type="button"
      aria-expanded="false"
      aria-controls="chat-panel"
    >
      <Image src={markPortrait} alt="Mark Rowlands" width={96} height={72} />
      <span>Hi there, have a question?<strong>Talk to us.</strong></span>
    </button>
    <button class="chat-teaser-close" type="button" aria-label="Dismiss message">&times;</button>
  </div>

  <section class="chat-panel" id="chat-panel" aria-hidden="true" inert>
    <header class="chat-panel-header">
      <Image src={markPortrait} alt="Mark Rowlands" width={96} height={72} />
      <div><strong>Have a question?</strong><span>We’re here to help.</span></div>
      <button class="chat-panel-close" type="button" aria-label="Close contact form">&times;</button>
    </header>
    <div class="chat-panel-body">
      <p class="chat-intro">Tell us what you need and Mark will get back to you personally.</p>
      <form class="chat-form">
        <label><span>Name</span><input name="name" autocomplete="name" placeholder="Name *" required /></label>
        <label><span>Phone</span><input name="phone" type="tel" autocomplete="tel" placeholder="Phone" /></label>
        <label><span>Email</span><input name="email" type="email" autocomplete="email" placeholder="Email *" required /></label>
        <label><span>Message</span><textarea name="message" placeholder="How can we help? *" required></textarea></label>
        <label class="chat-consent">
          <input type="checkbox" required />
          <span>I agree that Bespoke Aviation may contact me about this enquiry.</span>
        </label>
        <button class="chat-send" type="submit">Send enquiry <span aria-hidden="true">↗</span></button>
        <p class="chat-status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <button
    class="chat-toggle"
    type="button"
    aria-label="Open contact form"
    aria-expanded="false"
    aria-controls="chat-panel"
  >
    <svg viewBox="0 0 32 32" aria-hidden="true">
      <path d="M7.5 21.5 5 27l6-2.5c1.5.7 3.2 1 5 1 6.1 0 11-4.3 11-9.7S22.1 6 16 6 5 10.3 5 15.8c0 2.1.9 4.1 2.5 5.7Z"></path>
      <path d="M11 13h10M11 18h7"></path>
    </svg>
  </button>
</aside>

<script>
  const widget = document.querySelector<HTMLElement>(".chat-widget");
  if (widget) {
    const panel = widget.querySelector<HTMLElement>(".chat-panel");
    const toggle = widget.querySelector<HTMLButtonElement>(".chat-toggle");
    const teaserOpen = widget.querySelector<HTMLButtonElement>(".chat-teaser-open");
    const form = widget.querySelector<HTMLFormElement>(".chat-form");

    if (panel && toggle && teaserOpen && form) {
      const setOpen = (open: boolean) => {
        widget.classList.toggle("is-open", open);
        panel.inert = !open;
        panel.setAttribute("aria-hidden", String(!open));
        [toggle, teaserOpen].forEach((button) =>
          button.setAttribute("aria-expanded", String(open))
        );
        toggle.setAttribute("aria-label", `${open ? "Close" : "Open"} contact form`);
        if (open) requestAnimationFrame(() => panel.querySelector<HTMLInputElement>("input")?.focus());
      };

      toggle.addEventListener("click", () => setOpen(!widget.classList.contains("is-open")));
      teaserOpen.addEventListener("click", () => setOpen(true));
      widget.querySelector(".chat-teaser-close")?.addEventListener("click", () =>
        widget.classList.add("is-teaser-dismissed")
      );
      widget.querySelector(".chat-panel-close")?.addEventListener("click", () => {
        setOpen(false);
        toggle.focus();
      });
      document.addEventListener("keydown", ({ key }) => {
        if (key === "Escape" && widget.classList.contains("is-open")) {
          setOpen(false);
          toggle.focus();
        }
      });

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        const data = new FormData(form);
        const body = `Name: ${data.get("name")}\nPhone: ${data.get("phone") || "Not provided"}\nEmail: ${data.get("email")}\n\n${data.get("message")}`;
        const status = widget.querySelector<HTMLElement>(".chat-status");
        if (status) status.textContent = "Opening your email app…";
        location.href = `mailto:mark@bespoke-aviation.com?subject=${encodeURIComponent(`Website enquiry from ${data.get("name")}`)}&body=${encodeURIComponent(body)}`;
      });
    }
  }
</script>
