<script>
  import barba from "@barba/core";
  import { gsap } from "gsap";
  import Lenis from "lenis";
  import A11yDialog, { type A11yDialogInstance } from "a11y-dialog";
  import Swiper from "swiper";
  import { EffectFade, Keyboard, Navigation } from "swiper/modules";

  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
  const sliderInstances = new Map<HTMLElement, Swiper>();
  const quoteFormHandlers = new Map<HTMLFormElement, EventListener>();
  const aircraftDialogs = new Map<HTMLElement, { dialog: A11yDialogInstance; cleanup: () => void }>();

  const transitionDuration = () => reducedMotion.matches ? 0 : 0.35;
  const sliderSpeed = () => reducedMotion.matches ? 0 : 550;
  const fadeTo = (
    container: HTMLElement | null,
    opacity: number,
    ease: string,
  ) => container
    ? gsap.to(container, {
        opacity,
        duration: transitionDuration(),
        ease,
      })
    : Promise.resolve();

  const updateParallax = () => {
    const footer = document.querySelector<HTMLElement>(".footer");
    if (footer) {
      if (matchMedia("(min-width: 901px)").matches) {
        const rect = footer.getBoundingClientRect();
        const progress = Math.max(0, Math.min(1, (innerHeight - rect.top) / rect.height));
        footer.style.setProperty("--footer-parallax", `${(progress - 1) * 96}px`);
      } else {
        footer.style.removeProperty("--footer-parallax");
      }
    }

    const hero = document.querySelector<HTMLElement>(
      ".hero, .aircraft-hero, .contact-personal, .legal-hero",
    );
    if (hero) {
      const rect = hero.getBoundingClientRect();
      const headerHeight =
        document.querySelector<HTMLElement>(".site-header")?.offsetHeight ?? 0;
      const progress = Math.max(
        0,
        Math.min(1, (headerHeight - rect.top) / Math.min(rect.height, innerHeight)),
      );
      hero.style.setProperty("--hero-parallax", `${progress * 84}px`);
    }
  };

  if (!reducedMotion.matches) {
    window.bespokeLenis = new Lenis({ autoRaf: true, anchors: true });
    window.bespokeLenis.on("scroll", updateParallax);
    let lastViewportWidth = innerWidth;
    addEventListener("resize", () => {
      if (innerWidth === lastViewportWidth) return;
      lastViewportWidth = innerWidth;
      updateParallax();
    });
  }

  const updateTestimonialCount = (
    swiper: Swiper,
    count: HTMLElement | null | undefined,
    total: number,
  ) => {
    if (!count) return;
    count.textContent =
      `${String(swiper.realIndex + 1).padStart(2, "0")} / ${String(total).padStart(2, "0")}`;
  };

  const initializeSliders = (container: HTMLElement) => {
    container.querySelectorAll<HTMLElement>(".testimonial-swiper").forEach((slider) => {
      if (sliderInstances.has(slider)) return;

      const copy = slider.closest<HTMLElement>(".testimonial-copy");
      const count = copy?.querySelector<HTMLElement>(".testimonial-count");
      const total = slider.querySelectorAll(".swiper-slide").length;
      const instance = new Swiper(slider, {
        modules: [EffectFade, Keyboard, Navigation],
        slidesPerView: 1,
        speed: sliderSpeed(),
        effect: "fade",
        fadeEffect: { crossFade: true },
        autoHeight: true,
        loop: true,
        grabCursor: true,
        keyboard: { enabled: true, onlyInViewport: true },
        navigation: {
          prevEl: copy?.querySelector<HTMLElement>(".testimonial-prev"),
          nextEl: copy?.querySelector<HTMLElement>(".testimonial-next"),
        },
        on: {
          init: (swiper) => updateTestimonialCount(swiper, count, total),
          slideChange: (swiper) => updateTestimonialCount(swiper, count, total),
        },
      });
      sliderInstances.set(slider, instance);
    });

    container.querySelectorAll<HTMLElement>(".aircraft-swiper").forEach((slider) => {
      if (sliderInstances.has(slider)) return;

      const instance = new Swiper(slider, {
        modules: [EffectFade, Keyboard, Navigation],
        slidesPerView: 1,
        speed: sliderSpeed(),
        effect: "fade",
        fadeEffect: { crossFade: true },
        grabCursor: true,
        rewind: true,
        watchOverflow: true,
        keyboard: { enabled: true, onlyInViewport: true },
        navigation: {
          prevEl: slider.querySelector<HTMLElement>(".aircraft-slider-prev"),
          nextEl: slider.querySelector<HTMLElement>(".aircraft-slider-next"),
        },
      });
      sliderInstances.set(slider, instance);
    });
  };

  const handleQuoteSubmit = (event: Event) => {
    event.preventDefault();
    const form = event.currentTarget;
    if (!(form instanceof HTMLFormElement) || !form.reportValidity()) return;

    const data = new FormData(form);
    const body = [
      `Departure: ${data.get("departure") || "Not provided"}`,
      `Destination: ${data.get("destination") || "Not provided"}`,
      `Date: ${data.get("date") || "Not provided"}`,
      `Passengers: ${data.get("passengers")}`,
      `Phone: ${data.get("phone") || "Not provided"}`,
      `Email: ${data.get("email")}`,
    ].join("\n");

    location.href =
      `mailto:mark@bespoke-aviation.com?subject=${encodeURIComponent("Private charter enquiry")}&body=${encodeURIComponent(body)}`;
  };

  const initializeQuoteForms = (container: HTMLElement) => {
    container.querySelectorAll<HTMLFormElement>(".quote-form").forEach((form) => {
      if (quoteFormHandlers.has(form)) return;
      const handler: EventListener = handleQuoteSubmit;
      form.addEventListener("submit", handler);
      quoteFormHandlers.set(form, handler);
    });
  };

  const initializeAircraftPage = (container: HTMLElement) => {
    const sheet = container.querySelector<HTMLElement>(".aircraft-sheet");
    if (!sheet || aircraftDialogs.has(container)) return;
    const dialog = new A11yDialog(sheet);
    const panel = sheet.querySelector<HTMLElement>(".aircraft-sheet-panel");
    const overlay = sheet.querySelector<HTMLElement>(".aircraft-sheet-overlay");
    const title = sheet.querySelector<HTMLElement>("#aircraft-sheet-title");
    const type = sheet.querySelector<HTMLElement>("#aircraft-sheet-type");
    const passengers = sheet.querySelector<HTMLElement>("#aircraft-sheet-passengers");
    const performance = sheet.querySelector<HTMLElement>("#aircraft-sheet-performance");
    const performanceTitle = sheet.querySelector<HTMLElement>("#aircraft-sheet-performance-title");
    const metrics = sheet.querySelector<HTMLElement>("#aircraft-sheet-metrics");
    const dragHandle = sheet.querySelector<HTMLElement>(".aircraft-sheet-drag-handle");
    const entranceContent = Array.from(panel?.querySelectorAll<HTMLElement>(
      ".aircraft-sheet-drag-handle, .aircraft-sheet-close, .aircraft-sheet-panel > .eyebrow, .aircraft-sheet-panel > h2, .aircraft-sheet-passengers, .aircraft-sheet-performance",
    ) ?? []);
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const listeners: Array<[EventTarget, string, EventListener]> = [];
    let closing = false;
    let dragStart: number | undefined;
    const duration = () => reduced.matches ? 0 : 0.42;
    const listen = (target: EventTarget, event: string, handler: EventListener) => {
      target.addEventListener(event, handler);
      listeners.push([target, event, handler]);
    };
    const close = () => {
      if (!panel || !overlay || closing) return;
      if (reduced.matches) { dialog.hide(); return; }
      closing = true;
      gsap.killTweensOf([panel, overlay]);
      gsap.to(panel, { y: panel.offsetHeight, duration: duration(), ease: "power3.in" });
      gsap.to(overlay, { opacity: 0, duration: duration() * 0.72, ease: "power2.in", onComplete: () => { dialog.hide(); closing = false; } });
    };
    const hide: EventListener = (event) => {
      if (closing || reduced.matches) return;
      event.preventDefault();
      close();
    };
    dialog.on("show", () => {
      if (!panel || !overlay) return;
      closing = false;
      gsap.killTweensOf([panel, overlay, entranceContent]);
      if (reduced.matches) {
        gsap.set([panel, overlay, entranceContent], { clearProps: "all" });
        return;
      }
      gsap.set(panel, { y: 0, yPercent: 105, opacity: 0 });
      gsap.set(overlay, { opacity: 0 });
      gsap.set(entranceContent, { y: 18, opacity: 0 });
      gsap.timeline()
        .to(overlay, { opacity: 1, duration: 0.28, ease: "power2.out" })
        .to(panel, { yPercent: 0, opacity: 1, duration: 0.58, ease: "power4.out" }, 0)
        .to(entranceContent, { y: 0, opacity: 1, duration: 0.34, stagger: 0.045, ease: "power2.out" }, 0.2);
    });
    dialog.on("hide", hide);
    container.querySelectorAll<HTMLButtonElement>(".aircraft-info-trigger").forEach((trigger) => {
      listen(trigger, "click", () => {
        if (!title || !type || !passengers || !performance || !performanceTitle || !metrics) return;
        title.textContent = trigger.dataset.aircraftName ?? "";
        type.textContent = trigger.dataset.aircraftType ?? "";
        passengers.textContent = `Up to ${trigger.dataset.aircraftPassengers} passengers`;
        metrics.replaceChildren();
        const data = trigger.dataset.aircraftPerformance;
        if (data) {
          const details = JSON.parse(data) as { title: string; metrics: Array<{ label: string; value: string }> };
          performanceTitle.textContent = details.title;
          details.metrics.forEach(({ label, value }) => {
            const row = document.createElement("div");
            const term = document.createElement("dt");
            const definition = document.createElement("dd");
            term.textContent = label; definition.textContent = value; row.append(term, definition); metrics.append(row);
          });
          performance.hidden = false;
        } else performance.hidden = true;
        dialog.show();
      });
    });
    if (dragHandle) {
      listen(dragHandle, "pointerdown", ((event: PointerEvent) => {
        if (event.button !== 0 || !panel) return;
        dragStart = event.clientY; dragHandle.setPointerCapture(event.pointerId); gsap.killTweensOf([panel, overlay]);
      }) as EventListener);
      listen(dragHandle, "pointermove", ((event: PointerEvent) => {
        if (dragStart === undefined || !panel || !overlay) return;
        const distance = Math.max(0, event.clientY - dragStart);
        gsap.set(panel, { y: Math.min(distance, innerHeight) });
        gsap.set(overlay, { opacity: Math.max(0, 1 - distance / (panel.offsetHeight * 0.8)) });
      }) as EventListener);
      const finish = (event: PointerEvent) => {
        if (dragStart === undefined || !panel || !overlay) return;
        const distance = event.clientY - dragStart; dragStart = undefined;
        if (dragHandle.hasPointerCapture(event.pointerId)) dragHandle.releasePointerCapture(event.pointerId);
        if (distance > Math.min(Math.max(panel.offsetHeight * 0.28, 120), 240)) { close(); return; }
        gsap.to(panel, { y: 0, duration: duration(), ease: "elastic.out(1, 0.7)" });
        gsap.to(overlay, { opacity: 1, duration: duration() * 0.7, ease: "power2.out" });
      };
      listen(dragHandle, "pointerup", finish as EventListener);
      listen(dragHandle, "pointercancel", finish as EventListener);
    }
    aircraftDialogs.set(container, { dialog, cleanup: () => {
      listeners.forEach(([target, event, handler]) => target.removeEventListener(event, handler));
      dialog.off("hide", hide); gsap.killTweensOf([panel, overlay]); dialog.destroy();
    } });
  };
  const initializePage = (container: HTMLElement) => {
    initializeSliders(container);
    initializeQuoteForms(container);
    initializeAircraftPage(container);
    container.querySelectorAll<HTMLVideoElement>("video[autoplay]").forEach((video) => {
      video.muted = true;
      video.load();
      video.play().catch(() => {});
    });
    requestAnimationFrame(updateParallax);
  };

  const destroyPage = (container: HTMLElement) => {
    aircraftDialogs.get(container)?.cleanup();
    aircraftDialogs.delete(container);
    container.querySelectorAll<HTMLElement>(".swiper").forEach((slider) => {
      const instance = sliderInstances.get(slider);
      instance?.destroy(true, true);
      sliderInstances.delete(slider);
    });

    container.querySelectorAll<HTMLFormElement>(".quote-form").forEach((form) => {
      const handler = quoteFormHandlers.get(form);
      if (handler) form.removeEventListener("submit", handler);
      quoteFormHandlers.delete(form);
    });
  };

  const managedHeadSelectors = [
    'link[rel="canonical"]',
    'meta[name="description"]',
    'meta[name="robots"]',
    'meta[property^="og:"]',
    'meta[name^="twitter:"]',
    'script[type="application/ld+json"]',
  ];

  const synchronizeHead = (html: string) => {
    const incomingDocument = new DOMParser().parseFromString(html, "text/html");
    document.title = incomingDocument.title;

    managedHeadSelectors.forEach((selector) => {
      document.head.querySelectorAll(selector).forEach((node) => node.remove());
      incomingDocument.head.querySelectorAll(selector).forEach((node) => {
        document.head.append(node.cloneNode(true));
      });
    });
  };

  const updateNavigation = (namespace: string | undefined) => {
    document.querySelectorAll<HTMLAnchorElement>("[data-nav-namespace]").forEach((link) => {
      if (link.dataset.navNamespace === namespace) {
        link.setAttribute("aria-current", "page");
      } else {
        link.removeAttribute("aria-current");
      }
    });
  };

  const resetScroll = () => {
    if (window.bespokeLenis) {
      window.bespokeLenis.scrollTo(0, { immediate: true, force: true });
    } else {
      scrollTo(0, 0);
    }
  };

  const restoreDestinationHash = (hash: string | undefined) => {
    if (!hash) return false;
    const id = decodeURIComponent(hash.replace(/^#/, ""));
    const target = document.getElementById(id);
    if (!target) return false;

    if (window.bespokeLenis) {
      window.bespokeLenis.scrollTo(target, { immediate: true, force: true });
    } else {
      target.scrollIntoView();
    }
    return true;
  };

  const releaseTransitionLock = () => {
    document.body.classList.remove("is-transitioning");
    window.bespokeLenis?.start();
  };

  const initialContainer =
    document.querySelector<HTMLElement>('[data-barba="container"]');
  if (initialContainer) initializePage(initialContainer);

  barba.init({
    preventRunning: true,
    timeout: 5000,
    transitions: [
      {
        name: "page-fade",
        once({ current }) {
          updateNavigation(current.namespace);
          return Promise.resolve();
        },
        before() {
          document.body.classList.add("is-transitioning");
          document.body.classList.remove("menu-open");
          window.bespokeLenis?.stop();
        },
        beforeLeave({ current }) {
          if (current.container) destroyPage(current.container);
        },
        leave({ current }) {
          return fadeTo(current.container, 0, "sine.out");
        },
        afterLeave() {
          resetScroll();
        },
        beforeEnter({ next }) {
          synchronizeHead(next.html);
          updateNavigation(next.namespace);
          if (next.container) gsap.set(next.container, { opacity: 0 });
        },
        enter() {},
        afterEnter({ next }) {
          if (!next.container) return;
          initializePage(next.container);
          window.bespokeLenis?.resize();
          const restoredHash = restoreDestinationHash(next.url?.hash);
          const heading = next.container.querySelector<HTMLElement>("h1");
          if (!restoredHash && heading) {
            heading.tabIndex = -1;
            heading.focus({ preventScroll: true });
          }
        },
        after({ next }) {
          return new Promise((resolve) => {
            gsap.to(next.container, { opacity: 1, duration: transitionDuration(), ease: "sine.out", onComplete: () => { releaseTransitionLock(); resolve(undefined); } });
          });
        },
      },
    ],
  });

  barba.hooks.afterOnce(releaseTransitionLock);
</script>
