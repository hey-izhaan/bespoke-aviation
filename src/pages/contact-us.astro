---
import { Picture } from "astro:assets";
import QuoteForm from "../components/forms/QuoteForm.astro";
import SectionLabel from "../components/ui/SectionLabel.astro";
import markPhoto from "../assets/images/mark-rowlands-baseline.avif";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/paths";
---

<BaseLayout
  title="Request a Quote — Bespoke Aviation"
  description="Contact Bespoke Aviation to arrange your private aircraft charter."
  currentPage="contact"
>
  <main id="top">
    <section class="contact-personal">
      <div class="contact-portrait">
        <Picture
          src={markPhoto}
          formats={["avif"]}
          fallbackFormat="avif"
          layout="full-width"
          alt="Mark Rowlands, Founder of Bespoke Aviation"
        />
      </div>
      <div class="contact-details">
        <SectionLabel number="01">Your direct contact</SectionLabel>
        <h2>One experienced point<br /><em>of contact, throughout.</em></h2>
        <p>With over thirty years of industry experience, Mark will personally manage every step of your journey.</p>
        <div class="contact-links">
          <a href="mailto:mark@bespoke-aviation.com"><span>Email</span>mark@bespoke-aviation.com</a>
          <a href="tel:+447797923575"><span>Telephone</span>+44 (0)7797 923 575</a>
        </div>
        <div class="contact-accreditation">
          <img src={withBase("aca-logo.avif")} alt="The Air Charter Association" />
          <p>Accredited by the leading worldwide trade association for aircraft charter professionals.</p>
        </div>
      </div>
    </section>

    <section class="contact-page section-pad">
      <div class="enquiry-intro">
        <SectionLabel number="02" light>Start your journey</SectionLabel>
        <h1>Tell us where<br /><em>you need to be.</em></h1>
        <p>Share your plans and Mark will respond personally with suitable charter options selected around your schedule and priorities.</p>
        <div class="response-time"><span>Typically responds</span><strong>within 30 minutes</strong></div>
      </div>
      <QuoteForm />
    </section>
  </main>
</BaseLayout>

<style is:global>
  .contact-portrait > picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .contact-portrait > picture > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
