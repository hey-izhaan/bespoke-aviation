---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/paths";
import termsDocument from "../../terms.html?raw";

const legacyMainContent = termsDocument.match(/<main id="top">([\s\S]*?)<\/main>/)?.[1];
const mainContent = legacyMainContent?.replace('class="text-link"', 'class="button button-text"').replace(
  /href="contact-us\.html"/g,
  `href="${withBase("contact-us")}"`,
);

if (!mainContent) {
  throw new Error("Unable to extract the legal content from terms.html.");
}
---

<BaseLayout
  title="Privacy Policy & Terms — Bespoke Aviation"
  description="Privacy policy and charter terms for Bespoke Aviation Limited."
  currentPage="terms"
>
  <main id="top" set:html={mainContent}></main>
</BaseLayout>
